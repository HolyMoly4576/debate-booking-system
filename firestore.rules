rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Coaches collection - public read, write only for coaches
    match /coaches/{coachId} {
      allow read: if true;
      allow write: if request.auth.uid == coachId;
      allow update: if request.auth.uid == coachId;
      allow delete: if request.auth.uid == coachId;
    }

    // Availability slots - public read, write only by coach
    match /availability/{availabilityId} {
      allow read: if true;
      allow create: if request.auth.uid != null && resource.data.coachId == request.auth.uid;
      allow update: if request.auth.uid == resource.data.coachId;
      allow delete: if request.auth.uid == resource.data.coachId;
    }

    // Bookings - read own bookings, write for users, admins can read all
    match /bookings/{bookingId} {
      allow read: if request.auth.uid == resource.data.userId ||
                     request.auth.uid == resource.data.coachId ||
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow create: if request.auth.uid == request.resource.data.userId &&
                       request.resource.data.status == 'pending_approval' &&
                       request.resource.data.userId == request.auth.uid;

      allow update: if request.auth.uid == resource.data.userId ||
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Booking Approvals - only admins can access
    match /bookingApprovals/{approvalId} {
      allow read, write, create, update, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
